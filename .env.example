# --- Gemma 4 ---------------------------------------------------------------
# Provider: google (Google AI Studio / Gemini API) | ollama (local) | fake (tests only)
GEMMA_PROVIDER=google
# Leave empty to auto-discover the best available Gemma 4 model (never falls back to non-Gemma)
GEMMA_MODEL=
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
GEMMA_TEMPERATURE=0.15
GEMMA_MAX_CONCURRENCY=3

# --- Metadata (optional; raises GitHub rate limits) -------------------------
GITHUB_TOKEN=

# --- Execution ---------------------------------------------------------------
SANDBOX=local
PYTHON_VERSIONS=["3.12"]
WORKERS=3
HEAL_ATTEMPTS=3
